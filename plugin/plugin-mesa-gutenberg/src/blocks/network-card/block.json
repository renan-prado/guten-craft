{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mesa-gutenberg/network-card",
	"version": "1.0.0",
	"title": "Network Card",
	"category": "mesa-gutenberg",
	"icon": "id-alt",
	"description": "Card altamente customizável para a seção Network. Aceita qualquer combinação de blocos nativos (heading, paragraph, image, video, buttons). Suporta layouts media-side, media-top, text-only e showcase (full-width).",
	"keywords": ["card", "network", "iconnections"],
	"textdomain": "mesa-gutenberg",
	"parent": null,
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"attributes": {
		"layout": {
			"type": "string",
			"default": "media-side"
		},
		"mediaPosition": {
			"type": "string",
			"default": "left"
		},
		"alignment": {
			"type": "string",
			"default": "left"
		},
		"fullWidth": {
			"type": "boolean",
			"default": false
		},
		"backgroundColor": {
			"type": "string",
			"default": "rgba(255,255,255,0.04)"
		},
		"borderColor": {
			"type": "string",
			"default": "rgba(255,255,255,0.1)"
		},
		"radius": {
			"type": "number",
			"default": 16
		},
		"padding": {
			"type": "number",
			"default": 16
		},
		"mediaWidth": {
			"type": "number",
			"default": 240
		},
		"mediaHeight": {
			"type": "number",
			"default": 200
		},
		"gap": {
			"type": "number",
			"default": 32
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true
		}
	}
}
