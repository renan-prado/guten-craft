{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mesa-gutenberg/responsive-image",
	"version": "1.0.0",
	"title": "Responsive Image",
	"category": "mesa-gutenberg",
	"icon": "format-image",
	"description": "Single image block with separate desktop and mobile sources. Swaps automatically via CSS at the configured breakpoint.",
	"keywords": ["image", "responsive", "mobile", "desktop"],
	"textdomain": "mesa-gutenberg",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"attributes": {
		"desktopUrl":   { "type": "string", "default": "" },
		"desktopId":    { "type": "number" },
		"desktopAlt":   { "type": "string", "default": "" },
		"mobileUrl":    { "type": "string", "default": "" },
		"mobileId":     { "type": "number" },
		"mobileAlt":    { "type": "string", "default": "" },
		"breakpoint":   { "type": "number", "default": 768 }
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": { "margin": true, "padding": true }
	}
}
